rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /shops/{shopId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /orders/{orderId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /suppliers/{supplierId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Tokens only via Admin SDK (Cloud Functions)
      match /etsyCredentials/{shopId} {
        allow read, write: if false;
      }
    }

    // Short-lived OAuth PKCE sessions — Functions only
    match /oauthSessions/{state} {
      allow read, write: if false;
    }
  }
}
